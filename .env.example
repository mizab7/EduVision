# ==============================================================================
# EduVision AI - Environment Configuration Template
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="EduVision AI"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# ------------------------------------------------------------------------------
# Database & Vector Index
# ------------------------------------------------------------------------------
# SQLite Default:
DATABASE_URL="sqlite:///./data/eduvision.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/eduvision"

FAISS_INDEX_PATH="./data/faiss_index.bin"
STUDENT_MAPPING_PATH="./data/student_mapping.pkl"

# ------------------------------------------------------------------------------
# Generative AI (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_TEMPERATURE=0.4

# ------------------------------------------------------------------------------
# Camera & Video Stream
# ------------------------------------------------------------------------------
# Hardware camera index (0 for default webcam, 1 for external USB camera)
CAMERA_INDEX=0

# RTSP Stream URL (uncomment to use IP / CCTV camera instead of local webcam)
# CAMERA_RTSP_URL="rtsp://admin:password@192.168.1.50:554/stream1"

FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS_TARGET=30

# ------------------------------------------------------------------------------
# Model Paths & Inference Settings
# ------------------------------------------------------------------------------
YOLO_MODEL_PATH="./models/yolov8n.pt"
INSIGHTFACE_MODEL_NAME="buffalo_l"
MEDIAPIPE_MAX_NUM_FACES=10

# ------------------------------------------------------------------------------
# Detection & Engagement Thresholds
# ------------------------------------------------------------------------------
# Cosine similarity cutoff for face recognition (0.0 to 1.0)
FACE_RECOGNITION_THRESHOLD=0.60

# Liveness confidence score cutoff (0.0 to 1.0)
LIVENESS_CONFIDENCE_THRESHOLD=0.75

# Eye Aspect Ratio (EAR) below which an eye is considered closed
EAR_CLOSED_THRESHOLD=0.21

# Number of consecutive frames of eye closure to flag as drowsiness
DROWSY_CONSECUTIVE_FRAMES=20

# Mouth Aspect Ratio (MAR) above which a mouth is considered yawning
MAR_YAWN_THRESHOLD=0.65

# Head pose angle limit (degrees) for considering focus forward
HEAD_YAW_THRESHOLD=25.0
HEAD_PITCH_THRESHOLD=20.0

# YOLO confidence threshold for mobile phone detection
YOLO_PHONE_CONFIDENCE=0.45

# Overall engagement score cutoff (below which teacher alerts are triggered)
ENGAGEMENT_ALERT_THRESHOLD=45.0
